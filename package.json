{
  "name": "pi-reflex",
  "version": "0.1.4",
  "description": "TypeScript-native System 1 decision engine: non-autoregressive choice/score/noul decisions with calibrated probabilities, conformal guarantees, multilingual routing. A Jev-style, laya-compatible open alternative (not affiliated with TypeSafe). Zero Python at runtime.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pungggi/pi-reflex.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "pi-reflex-mcp": "bin/pi-reflex-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./lang": {
      "types": "./dist/lang/index.d.ts",
      "default": "./dist/lang/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "default": "./dist/extension/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"if(!process.env.CI)throw new Error('publish via release.yml CI: push a v* tag. Manual npm publish is blocked to guarantee provenance + version sync (first-publish bootstrap documented in docs/PUBLISHING.md).')\""
  },
  "keywords": [
    "pi-package",
    "system1",
    "decision-engine",
    "reflex",
    "classification",
    "calibration",
    "conformal",
    "llm-router",
    "guardrails",
    "jev",
    "laya",
    "von",
    "onnx"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-ai": "*",
    "typebox": "*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.30.0"
  }
}
